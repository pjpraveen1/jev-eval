# Copy to .env and fill in — or export these directly in your shell.
# .env is gitignored so real values never end up in the repo.

# TypeSafe AI (Jev) — required by verify_session.py
# Get one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# AWS credentials for Bedrock (verify_session_bedrock.py)
# Uses the standard AWS credential chain — set AWS_PROFILE, or export
# AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY, or attach an IAM role.
# AWS_REGION defaults to us-east-1 in verify_session_bedrock.py.
AWS_REGION=us-east-1
